# kalshi-recorder configuration
# Copy to .env and fill in. Never commit .env (contains API key paths).

# Kalshi API (read-only key; lives only on the recording host)
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/key.pem
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2

# Universe selection
REC_MAX_MARKETS=175
REC_MIN_VOLUME_24H=500
# Empty = all categories (full ~15k series universe).
# Set to comma-separated series prefixes to restrict (e.g. "KXNFL,KXNBA").
REC_UNIVERSE_INCLUDE=
REC_SPORTS_RESERVE=40

# Polling
REC_BOOK_POLL_S=15
REC_TRADES_POLL_S=30
REC_ENUMERATE_HOURS=12

# Enumeration pacing (be nice to the API)
REC_ENUMERATE_CONCURRENCY=1
REC_ENUMERATE_PACE_S=2.0
REC_ENUMERATE_SERIES_TIMEOUT_S=120

# Paths
REC_RECORDINGS_DIR=data/recordings
REC_WATERMARK_PATH=data/recordings/watermark.json

# WebSocket (requires API key; disabled without one)
REC_WS_ENABLED=true
